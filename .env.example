# Base de datos durable para producción y desarrollo con Neon Postgres.
# Prioridad runtime:
# 1) DATABASE_URL cuando apunta a Postgres.
# 2) NETLIFY_DB_URL inyectada por Netlify Database/Neon.
# 3) no-op solo para local/demo sin Postgres.
# Usa la cadena pooled de Neon para la app/runtime.
# Ejemplo:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require&channel_binding=require"
DATABASE_URL=""

# Opcional: cadena directa/no pooled si se usa en flujos de migración manuales.
DIRECT_URL=""

# Netlify Database/Neon puede inyectar esta variable automáticamente en runtime.
# No la configures manualmente salvo que Netlify lo indique.
NETLIFY_DB_URL=""

# Proveedor principal recomendado para cobertura amplia internacional.
# Obtén la clave en el dashboard oficial de API-FOOTBALL / API-Sports.
FOOTBALL_API_KEY=""

# Proveedor complementario útil para ligas europeas y competiciones UEFA.
# Obtén el token en football-data.org.
FOOTBALL_DATA_API_KEY=""

# Proveedor complementario distinto a Football-Data.org.
# Usa autenticacion Bearer y cuota mensual gratuita.
FOOTBALLDATA_IO_API_KEY=""
FOOTBALLDATA_IO_BASE_URL="https://footballdata.io/api/v1"

# Proveedor secundario gratuito para enriquecimiento de eventos/equipos.
THE_SPORTSDB_API_KEY=""
THE_SPORTSDB_BASE_URL="https://www.thesportsdb.com/api/v1/json"
THE_SPORTSDB_TIMEOUT_MS="8000"

# Proveedor de cuotas para value betting y surebets.
# Obtén la clave en The Odds API.
# Flujo conservador plan gratis:
# - /sports y /events no consumen cuota.
# - /events/{eventId}/odds consume por mercados x regiones.
# Defaults recomendados: una región y h2h para abrir detalle sin quemar cuota.
ODDS_API_KEY=""
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"
ODDS_API_REGIONS="eu"
ODDS_API_MARKETS="h2h"
ODDS_API_BOOKMAKERS=""
ODDS_API_TIMEOUT_MS="8000"

# Reservado para redacción opcional futura. No se usa en el análisis determinista actual.
OPENAI_API_KEY=""
