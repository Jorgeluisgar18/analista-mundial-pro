DATABASE_URL="file:./prisma/dev.db"

# Proveedor principal recomendado para cobertura amplia internacional.
# Obtén la clave en el dashboard oficial de API-FOOTBALL / API-Sports.
FOOTBALL_API_KEY=""

# Proveedor complementario útil para ligas europeas y competiciones UEFA.
# Obtén el token en football-data.org.
FOOTBALL_DATA_API_KEY=""

# Proveedor de cuotas para value betting y surebets.
# Obtén la clave en The Odds API.
ODDS_API_KEY=""

# Reservado para redacción opcional futura. No se usa en el análisis determinista actual.
OPENAI_API_KEY=""
