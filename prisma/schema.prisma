generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Competition {
  id         String   @id @default(cuid())
  externalId String   @unique
  name       String
  kind       String
  matches    Match[]
  historicalMatches HistoricalMatch[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Team {
  id          String   @id @default(cuid())
  externalId  String   @unique
  name        String
  code        String?
  kind        String
  homeMatches Match[]  @relation("HomeTeam")
  awayMatches Match[]  @relation("AwayTeam")
  historicalHomeMatches HistoricalMatch[] @relation("HistoricalHomeTeam")
  historicalAwayMatches HistoricalMatch[] @relation("HistoricalAwayTeam")
  historicalTeamMatches HistoricalTeamMatch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Match {
  id            String           @id @default(cuid())
  externalId    String           @unique
  kickoff       DateTime
  status        String
  stage         String?
  venue         String?
  city          String?
  country       String?
  timezone      String           @default("UTC")
  dataOrigin    String           @default("DEMO")
  competitionId String
  homeTeamId    String
  awayTeamId    String
  competition   Competition      @relation(fields: [competitionId], references: [id])
  homeTeam      Team             @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team             @relation("AwayTeam", fields: [awayTeamId], references: [id])
  snapshots     MatchSnapshot[]
  overrides     ManualOverride[]
  odds          OddsSnapshot[]
  analyses      AnalysisRun[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([kickoff])
  @@index([competitionId, kickoff])
}

model MatchSnapshot {
  id        String           @id @default(cuid())
  matchId   String
  hash      String
  payload   String
  fetchedAt DateTime
  source    String
  isStale   Boolean          @default(false)
  match     Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  evidence  EvidenceRecord[]
  analyses  AnalysisRun[]
  createdAt DateTime         @default(now())

  @@unique([matchId, hash])
  @@index([matchId, fetchedAt])
}

model EvidenceRecord {
  id         String        @id @default(cuid())
  snapshotId String
  field      String
  value      String
  status     String
  sourceType String
  source     String
  url        String?
  observedAt DateTime
  note       String?
  snapshot   MatchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, field])
}

model OddsSnapshot {
  id         String   @id @default(cuid())
  matchId    String
  bookmaker  String
  market     String
  outcome    String
  odd        Float
  observedAt DateTime
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, bookmaker, market, outcome, observedAt])
  @@index([matchId, market, observedAt])
}

model ModelVersion {
  id        String        @id @default(cuid())
  name      String
  version   String
  config    String
  metrics   String?
  analyses  AnalysisRun[]
  createdAt DateTime      @default(now())

  @@unique([name, version])
}

model AnalysisRun {
  id              String        @id @default(cuid())
  matchId         String
  snapshotId      String
  modelVersionId  String
  inputHash       String
  result          String
  manuallyUpdated Boolean       @default(false)
  match           Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  snapshot        MatchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  modelVersion    ModelVersion  @relation(fields: [modelVersionId], references: [id])
  predictions     Prediction[]
  createdAt       DateTime      @default(now())

  @@index([matchId, createdAt])
  @@index([inputHash])
}

model Prediction {
  id             String      @id @default(cuid())
  analysisRunId  String
  category       String
  market         String
  line           String?
  probability    Float?
  confidence     Float
  riskLevel      String
  reason         String
  risk           String
  minimumOdd     Float?
  availableOdd   Float?
  expectedValue  Float?
  marketProbability Float?
  modelEdge      Float?
  evidenceStatus String
  analysisRun    AnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  @@index([analysisRunId, category])
}

model ManualOverride {
  id          String   @id @default(cuid())
  matchId     String
  type        String
  description String
  sourceUrl   String?
  teamId      String?
  player      String?
  impact      String?
  area        String?
  value       String?
  observedAt  DateTime
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([matchId, createdAt])
}

model ApiUsage {
  id        String   @id @default(cuid())
  provider  String
  period    String   @default("day")
  periodKey String
  used      Int      @default(0)
  limit     Int
  resetsAt  DateTime
  updatedAt DateTime @updatedAt

  @@unique([provider, periodKey])
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  scope     String
  clientKey String
  count     Int      @default(0)
  resetsAt  DateTime
  updatedAt DateTime @updatedAt

  @@unique([scope, clientKey])
  @@index([resetsAt])
}

model ProviderTelemetry {
  id         String   @id @default(cuid())
  provider   String
  operation  String
  status     String
  latencyMs  Int
  errorCode  String?
  occurredAt DateTime @default(now())

  @@index([provider, occurredAt])
  @@index([operation, occurredAt])
}

model HistoricalImport {
  id          String   @id @default(cuid())
  sourceRepo  String
  sourceCommit String
  sourcePath  String
  importedAt  DateTime @default(now())
  fileCount   Int      @default(1)
  matchCount  Int      @default(0)
  rawMeta     String?
  matches     HistoricalMatch[]

  @@unique([sourceRepo, sourceCommit, sourcePath])
  @@index([sourceRepo, importedAt])
}

model HistoricalMatch {
  id            String   @id @default(cuid())
  externalId    String   @unique
  sourceRepo    String
  sourcePath    String
  sourceIndex   Int
  season        String
  round         String?
  group         String?
  kickoff       DateTime?
  kickoffDate   String
  homeGoals     Int?
  awayGoals     Int?
  rawJson       String
  importId      String
  competitionId String
  homeTeamId    String
  awayTeamId    String
  import        HistoricalImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  competition   Competition      @relation(fields: [competitionId], references: [id])
  homeTeam      Team             @relation("HistoricalHomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team             @relation("HistoricalAwayTeam", fields: [awayTeamId], references: [id])
  teamRows      HistoricalTeamMatch[]
  createdAt     DateTime @default(now())

  @@index([competitionId, kickoff])
  @@index([homeTeamId, kickoff])
  @@index([awayTeamId, kickoff])
  @@index([sourceRepo, sourcePath])
}

model HistoricalTeamMatch {
  id                String   @id @default(cuid())
  historicalMatchId String
  teamId            String
  opponentTeamId    String
  isHome            Boolean
  goalsFor          Int
  goalsAgainst      Int
  points            Int
  opponentElo       Float?
  kickoff           DateTime?
  historicalMatch   HistoricalMatch @relation(fields: [historicalMatchId], references: [id], onDelete: Cascade)
  team              Team            @relation(fields: [teamId], references: [id])

  @@unique([historicalMatchId, teamId])
  @@index([teamId, kickoff])
  @@index([opponentTeamId, kickoff])
}

model CalibrationRun {
  id          String   @id @default(cuid())
  modelName   String
  modelVersion String
  sampleSize  Int
  brier       Float
  logLoss     Float
  rps         Float
  empiricalHome Float
  empiricalDraw Float
  empiricalAway Float
  config      String
  createdAt   DateTime @default(now())

  @@index([modelName, modelVersion, createdAt])
}
