# Durable database for production/local development with Neon Postgres.
# Runtime priority:
# 1) DATABASE_URL when it points to Postgres.
# 2) NETLIFY_DB_URL injected by Netlify Database/Neon.
# 3) no-op persistence only for local/demo without Postgres.
#
# Paste your Neon pooled connection string locally in .env.local, not here.
DATABASE_URL=""

# Optional direct/non-pooled connection string for manual migration flows.
DIRECT_URL=""

# Netlify Database/Neon may inject this automatically at runtime.
# Do not configure manually unless Netlify tells you to.
NETLIFY_DB_URL=""

# Primary provider for broad international football coverage.
FOOTBALL_API_KEY=""

# Complementary provider for European leagues and UEFA competitions.
FOOTBALL_DATA_API_KEY=""

# Independent complementary provider with a free monthly quota.
FOOTBALLDATA_IO_API_KEY=""
FOOTBALLDATA_IO_BASE_URL="https://footballdata.io/api/v1"

# Secondary free provider for event/team enrichment.
THE_SPORTSDB_API_KEY=""
THE_SPORTSDB_BASE_URL="https://www.thesportsdb.com/api/v1/json"
THE_SPORTSDB_TIMEOUT_MS="8000"

# Odds provider for value betting and surebet analysis.
# Conservative free-plan defaults: one region and h2h market.
ODDS_API_KEY=""
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"
ODDS_API_REGIONS="eu"
ODDS_API_MARKETS="h2h"
ODDS_API_BOOKMAKERS=""
ODDS_API_TIMEOUT_MS="8000"

# Reserved for optional future assisted copy. Not used by the deterministic engine.
OPENAI_API_KEY=""

# Private credential required to create manual overrides from the analysis UI.
# Store the real value only in .env.local or Netlify environment variables.
ANALYST_OVERRIDE_TOKEN=""
